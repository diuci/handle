{
  "type": "module",
  "private": true,
  "name": "diuci-handle",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --port 4444",
    "build": "vite build",
    "preview": "vite preview",
    "update": "TEST=true vite-node tools/update.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "check:build": "node tools/check-build.mjs",
    "check:theme": "node tools/check-theme.mjs",
    "smoke": "node tools/smoke-handle.mjs",
    "selftest": "node tools/check-build.mjs --selftest && node tools/check-theme.mjs --selftest && node tools/smoke-handle.mjs --selftest"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "canvas-confetti": "^1.9.4",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "pinyin": "^2.11.2",
    "seedrandom": "^3.0.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.1.11",
    "@iconify-json/ep": "^1.1.8",
    "@iconify-json/mdi": "^1.1.37",
    "@iconify-json/ri": "^1.1.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.0.0",
    "@types/pinyin": "^2.10.2",
    "@types/seedrandom": "^3.0.8",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "ansis": "^4.4.0",
    "cheerio": "^1.2.0",
    "ohmyfetch": "^0.4.21",
    "typescript": "^5.6.0",
    "unbuild": "^3.6.1",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.3",
    "vite-node": "^5.0.3",
    "vitest": "^5.0.3",
    "puppeteer-core": "^25.12.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
