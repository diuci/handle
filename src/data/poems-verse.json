{
  "contentVersion": "2026.10.03",
  "forms": [
    "五言",
    "七言"
  ],
  "source": "local:C:\\Users\\chenhua\\Desktop\\diuci\\k12-chinese-poetry",
  "poems": [
    {
      "id": "baixuege",
      "title": "白雪歌送武判官归京",
      "author": "岑参",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级上册",
      "lines": [
        "北风卷地白草折胡天八月即飞雪",
        "忽如一夜春风来千树万树梨花开",
        "轮台东门送君去去时雪满天山路"
      ]
    },
    {
      "id": "biedongda",
      "title": "别董大",
      "author": "高适",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级上册",
      "lines": [
        "千里黄云白日曛北风吹雁雪纷纷",
        "莫愁前路无知己天下谁人不识君"
      ]
    },
    {
      "id": "bochuanguazhou",
      "title": "泊船瓜洲",
      "author": "王安石",
      "dynasty": "宋",
      "form": "七言",
      "stage": "小学",
      "grade": 6,
      "volume": "六年级下册",
      "lines": [
        "京口瓜洲一水间钟山只隔数重山",
        "春风又绿江南岸明月何时照我还"
      ]
    },
    {
      "id": "boqinhuai",
      "title": "泊秦淮",
      "author": "杜牧",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级下册",
      "lines": [
        "烟笼寒水月笼沙夜泊秦淮近酒家",
        "商女不知亡国恨隔江犹唱后庭花"
      ]
    },
    {
      "id": "cailianqu",
      "title": "采莲曲",
      "author": "王昌龄",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 3,
      "volume": "三年级上册",
      "lines": [
        "荷叶罗裙一色裁芙蓉向脸两边开",
        "乱入池中看不见闻歌始觉有人来"
      ]
    },
    {
      "id": "change",
      "title": "嫦娥",
      "author": "李商隐",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级上册",
      "lines": [
        "云母屏风烛影深长河渐落晓星沉",
        "嫦娥应悔偷灵药碧海青天夜夜心"
      ]
    },
    {
      "id": "chibi",
      "title": "赤壁",
      "author": "杜牧",
      "dynasty": "唐",
      "form": "七言",
      "stage": "高中",
      "grade": null,
      "volume": "必修下册",
      "lines": [
        "折戟沉沙铁未销自将磨洗认前朝",
        "东风不与周郎便铜雀春深锁二乔"
      ]
    },
    {
      "id": "chibi-du",
      "title": "赤壁",
      "author": "杜牧",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级下册",
      "lines": [
        "折戟沉沙铁未销自将磨洗认前朝",
        "东风不与周郎便铜雀春深锁二乔"
      ]
    },
    {
      "id": "chishang",
      "title": "池上",
      "author": "白居易",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级下册",
      "lines": [
        "小娃撑小艇偷采白莲回",
        "不解藏踪迹浮萍一道开"
      ]
    },
    {
      "id": "choulitian",
      "title": "酬乐天扬州初逢席上见赠",
      "author": "刘禹锡",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 9,
      "volume": "九年级上册",
      "lines": [
        "巴山楚水凄凉地二十三年弃置身",
        "怀旧空吟闻笛赋到乡翻似烂柯人",
        "沉舟侧畔千帆过病树前头万木春"
      ]
    },
    {
      "id": "chunjianghuayue",
      "title": "春江花月夜",
      "author": "张若虚",
      "dynasty": "唐",
      "form": "七言",
      "stage": "高中",
      "grade": null,
      "volume": "选择性必修下册",
      "lines": [
        "春江潮水连海平海上明月共潮生",
        "滟滟随波千万里何处春江无月明",
        "今人不见古时月今月曾经照古人"
      ]
    },
    {
      "id": "chunri",
      "title": "春日",
      "author": "朱熹",
      "dynasty": "宋",
      "form": "七言",
      "stage": "小学",
      "grade": 6,
      "volume": "六年级上册",
      "lines": [
        "胜日寻芳泗水滨无边光景一时新",
        "等闲识得东风面万紫千红总是春"
      ]
    },
    {
      "id": "chunwang",
      "title": "春望",
      "author": "杜甫",
      "dynasty": "唐",
      "form": "五言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级上册",
      "lines": [
        "国破山河在城春草木深",
        "感时花溅泪恨别鸟惊心",
        "烽火连三月家书抵万金",
        "白头搔更短浑欲不胜簪"
      ]
    },
    {
      "id": "chunxiao",
      "title": "春晓",
      "author": "孟浩然",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级下册",
      "lines": [
        "春眠不觉晓处处闻啼鸟",
        "夜来风雨声花落知多少"
      ]
    },
    {
      "id": "chunyeluocheng",
      "title": "春夜洛城闻笛",
      "author": "李白",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级课外诵读",
      "lines": [
        "谁家玉笛暗飞声散入春风满洛城",
        "此夜曲中闻折柳何人不起故园情"
      ]
    },
    {
      "id": "chunyexiyu",
      "title": "春夜喜雨",
      "author": "杜甫",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 6,
      "volume": "六年级下册",
      "lines": [
        "好雨知时节当春乃发生",
        "随风潜入夜润物细无声",
        "野径云俱黑江船火独明",
        "晓看红湿处花重锦官城"
      ]
    },
    {
      "id": "chusai",
      "title": "出塞",
      "author": "王昌龄",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级上册",
      "lines": [
        "秦时明月汉时关万里长征人未还",
        "但使龙城飞将在不教胡马度阴山"
      ]
    },
    {
      "id": "chuzhouxijian",
      "title": "滁州西涧",
      "author": "韦应物",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 3,
      "volume": "三年级下册",
      "lines": [
        "独怜幽草涧边生上有黄鹂深树鸣",
        "春潮带雨晚来急野渡无人舟自横"
      ]
    },
    {
      "id": "cibeigushanxia",
      "title": "次北固山下",
      "author": "王湾",
      "dynasty": "唐",
      "form": "五言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级上册",
      "lines": [
        "客路青山外行舟绿水前",
        "潮平两岸阔风正一帆悬",
        "海日生残夜江春入旧年",
        "乡书何处达归雁洛阳边"
      ]
    },
    {
      "id": "congjunxing",
      "title": "从军行",
      "author": "王昌龄",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 5,
      "volume": "五年级下册",
      "lines": [
        "青海长云暗雪山孤城遥望玉门关",
        "黄沙百战穿金甲不破楼兰终不还"
      ]
    },
    {
      "id": "cunju",
      "title": "村居",
      "author": "高鼎",
      "dynasty": "清",
      "form": "七言",
      "stage": "小学",
      "grade": 2,
      "volume": "二年级下册",
      "lines": [
        "草长莺飞二月天拂堤杨柳醉春烟",
        "儿童散学归来早忙趁东风放纸鸢"
      ]
    },
    {
      "id": "cunwan",
      "title": "村晚",
      "author": "雷震",
      "dynasty": "宋",
      "form": "七言",
      "stage": "小学",
      "grade": 5,
      "volume": "五年级下册",
      "lines": [
        "草满池塘水满陂山衔落日浸寒漪",
        "牧童归去横牛背短笛无腔信口吹"
      ]
    },
    {
      "id": "dalinsitaohua",
      "title": "大林寺桃花",
      "author": "白居易",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 3,
      "volume": "三年级下册",
      "lines": [
        "人间四月芳菲尽山寺桃花始盛开",
        "长恨春归无觅处不知转入此中来"
      ]
    },
    {
      "id": "dengfeilaifeng",
      "title": "登飞来峰",
      "author": "王安石",
      "dynasty": "宋",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级下册",
      "lines": [
        "飞来山上千寻塔闻说鸡鸣见日升",
        "不畏浮云遮望眼自缘身在最高层"
      ]
    },
    {
      "id": "denggao",
      "title": "登高",
      "author": "杜甫",
      "dynasty": "唐",
      "form": "七言",
      "stage": "高中",
      "grade": null,
      "volume": "必修上册",
      "lines": [
        "风急天高猿啸哀渚清沙白鸟飞回",
        "无边落木萧萧下不尽长江滚滚来",
        "万里悲秋常作客百年多病独登台",
        "艰难苦恨繁霜鬓潦倒新停浊酒杯"
      ]
    },
    {
      "id": "dengguanquelou",
      "title": "登鹳雀楼",
      "author": "王之涣",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 2,
      "volume": "二年级上册",
      "lines": [
        "白日依山尽黄河入海流",
        "欲穷千里目更上一层楼"
      ]
    },
    {
      "id": "dengkuai-ge",
      "title": "登快阁",
      "author": "黄庭坚",
      "dynasty": "宋",
      "form": "七言",
      "stage": "高中",
      "grade": null,
      "volume": "选择性必修下册",
      "lines": [
        "痴儿了却公家事快阁东西倚晚晴",
        "落木千山天远大澄江一道月分明",
        "朱弦已为佳人绝青眼聊因美酒横"
      ]
    },
    {
      "id": "dengyueyanglou",
      "title": "登岳阳楼",
      "author": "杜甫",
      "dynasty": "唐",
      "form": "五言",
      "stage": "高中",
      "grade": null,
      "volume": "必修上册",
      "lines": [
        "昔闻洞庭水今上岳阳楼",
        "吴楚东南坼乾坤日夜浮",
        "亲朋无一字老病有孤舟",
        "戎马关山北凭轩涕泗流"
      ]
    },
    {
      "id": "duzuojingting",
      "title": "独坐敬亭山",
      "author": "李白",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级下册",
      "lines": [
        "众鸟高飞尽孤云独去闲",
        "相看两不厌只有敬亭山"
      ]
    },
    {
      "id": "feng",
      "title": "风",
      "author": "李峤",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级上册",
      "lines": [
        "解落三秋叶能开二月花",
        "过江千尺浪入竹万竿斜"
      ]
    },
    {
      "id": "feng-mi",
      "title": "蜂",
      "author": "罗隐",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级下册",
      "lines": [
        "不论平地与山尖无限风光尽被占",
        "采得百花成蜜后为谁辛苦为谁甜"
      ]
    },
    {
      "id": "fengqiaoyebo",
      "title": "枫桥夜泊",
      "author": "张继",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 5,
      "volume": "五年级上册",
      "lines": [
        "月落乌啼霜满天江枫渔火对愁眠",
        "姑苏城外寒山寺夜半钟声到客船"
      ]
    },
    {
      "id": "fengrujinshi",
      "title": "逢入京使",
      "author": "岑参",
      "dynasty": "唐",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "七年级课外诵读",
      "lines": [
        "故园东望路漫漫双袖龙钟泪不干",
        "马上相逢无纸笔凭君传语报平安"
      ]
    },
    {
      "id": "furonglou",
      "title": "芙蓉楼送辛渐",
      "author": "王昌龄",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 4,
      "volume": "四年级下册",
      "lines": [
        "寒雨连江夜入吴平明送客楚山孤",
        "洛阳亲友如相问一片冰心在玉壶"
      ]
    },
    {
      "id": "guanshu",
      "title": "观书有感",
      "author": "朱熹",
      "dynasty": "宋",
      "form": "七言",
      "stage": "小学",
      "grade": 5,
      "volume": "五年级上册",
      "lines": [
        "半亩方塘一鉴开天光云影共徘徊",
        "问渠那得清如许为有源头活水来"
      ]
    },
    {
      "id": "guiyuantianju",
      "title": "归园田居",
      "author": "陶潜",
      "dynasty": "晋",
      "form": "五言",
      "stage": "高中",
      "grade": null,
      "volume": "必修上册",
      "lines": [
        "少无适俗韵性本爱丘山",
        "误落尘网中一去三十年",
        "羁鸟恋旧林池鱼思故渊",
        "开荒南野际守拙归园田"
      ]
    },
    {
      "id": "gulangyuexing",
      "title": "古朗月行",
      "author": "李白",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级上册",
      "lines": [
        "小时不识月呼作白玉盘",
        "又疑瑶台镜飞在青云端",
        "仙人垂两足桂树何团团",
        "白兔捣药成问言与谁餐"
      ]
    },
    {
      "id": "guogurenzhuang",
      "title": "过故人庄",
      "author": "孟浩然",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 6,
      "volume": "六年级上册",
      "lines": [
        "故人具鸡黍邀我至田家",
        "绿树村边合青山郭外斜",
        "开轩面场圃把酒话桑麻",
        "待到重阳日还来就菊花"
      ]
    },
    {
      "id": "guolingyang",
      "title": "过零丁洋",
      "author": "文天祥",
      "dynasty": "宋",
      "form": "七言",
      "stage": "初中",
      "grade": 7,
      "volume": "九年级下册",
      "lines": [
        "辛苦遭逢起一经干戈寥落四周星",
        "山河破碎风飘絮身世浮沉雨打萍",
        "惶恐滩头说惶恐零丁洋里叹零丁",
        "人生自古谁无死留取丹心照汗青"
      ]
    },
    {
      "id": "guyuancao",
      "title": "赋得古原草送别",
      "author": "白居易",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 2,
      "volume": "二年级下册",
      "lines": [
        "离离原上草一岁一枯荣",
        "野火烧不尽春风吹又生",
        "远芳侵古道晴翠接荒城",
        "又送王孙去萋萋满别情"
      ]
    },
    {
      "id": "hanshi",
      "title": "寒食",
      "author": "韩翃",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 6,
      "volume": "六年级下册",
      "lines": [
        "春城无处不飞花寒食东风御柳斜",
        "日暮汉宫传蜡烛轻烟散入五侯家"
      ]
    },
    {
      "id": "hua",
      "title": "画",
      "author": "王维",
      "dynasty": "唐",
      "form": "五言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级上册",
      "lines": [
        "远看山有色近听水无声",
        "春去花还在人来鸟不惊"
      ]
    },
    {
      "id": "huaji",
      "title": "画鸡",
      "author": "唐寅",
      "dynasty": "明",
      "form": "七言",
      "stage": "小学",
      "grade": 1,
      "volume": "一年级下册",
      "lines": [
        "头上红冠不用裁满身雪白走将来",
        "平生不敢轻言语一叫千门万户开"
      ]
    },
    {
      "id": "huanghelou",
      "title": "黄鹤楼送孟浩然之广陵",
      "author": "李白",
      "dynasty": "唐",
      "form": "七言",
      "stage": "小学",
      "grade": 5,
      "volume": "五年级下册",
      "lines": [
        "故人西辞黄鹤楼烟花三月下扬州",
